---
// A guide screenshot with an optional caption. `width` is the CSS width it shows at;
// the source is downscaled to 1x and 2x of that, so it stays sharp on high-density screens.
// Use a source at least `width` wide (2x for full sharpness); a narrower one is shown stretched.
// Don't read `src.width` (or any other field of `src`) here: Astro then copies the
// full-size original into the build next to the resized copies, and it ships unused.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	width: number;
	caption?: string;
}

const { src, alt, width, caption } = Astro.props;
---

<figure class="guide-figure">
	<Image src={src} alt={alt} width={width} densities={[1, 2]} />
	{caption && <figcaption>{caption}</figcaption>}
</figure>
